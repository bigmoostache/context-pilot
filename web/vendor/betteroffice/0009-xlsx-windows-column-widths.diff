+    #[test]
+    fn windows_metrics_size_columns_like_excel_web() {
+        let styles = Stylesheet::default();
+        // financial sample widths -> excel web's drawn pixels
+        let authored = [(0, 16.29), (1, 26.57), (2, 14.14), (3, 17.43), (4, 14.29)];
+        let mut sheet = sheet_with(&authored, &[]);
+        sheet.col_widths.insert(5, 0.0);
+        let width = |grid: &GridGeometry, col: ColId| grid.col_x(col + 1) - grid.col_x(col);
+
+        let mut windows = GridGeometry::with_row_metrics(&sheet, &styles, RowMetrics::Windows);
+        let drawn: Vec<_> = (0..5).map(|col| width(&windows, col)).collect();
+        assert_eq!(drawn, [114.0, 186.0, 99.0, 122.0, 100.0]);
+        assert_eq!(width(&windows, 5), 0.0);
+        assert_eq!(width(&windows, 6), col_chars_to_px(DEFAULT_COL_WIDTH_CHARS));
+
+        sheet.col_widths.insert(1, 10.0);
+        windows.update_columns(&sheet, [1]);
+        assert_eq!(width(&windows, 1), windows_col_px(10.0));
+        assert_eq!(windows_col_px(10.0), 70.0);
+
+        let mac = GridGeometry::new(&sheet_with(&authored, &[]), &styles);
+        for (col, chars) in authored {
+            assert_eq!(width(&mac, col), col_chars_to_px(chars), "col {col}");
         }
     }
 

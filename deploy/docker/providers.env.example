# Model provider keys for the LLM gateway. Copy to providers.env, fill in, keep
# private:
#
#   cp providers.env.example providers.env && chmod 600 providers.env
#
# Read ONLY by the litellm service (docker-compose.yml), never by the product
# container: that separation is what keeps the model keys out of the agents'
# environment and out of `docker inspect context-pilot`. In direct mode (no
# CP_LLM_GATEWAY) this file is unused and does not need to exist — the keys go in
# .env instead.
#
# The names below are what litellm.yaml references through `os.environ/…`; adding
# a provider means adding both a key here and a model_list entry there.

#ANTHROPIC_API_KEY=
#XAI_API_KEY=
#GROQ_API_KEY=
#DEEPSEEK_API_KEY=

@@ -826,3 +826,47 @@
         assert_eq!(value(&reopened, at), number(expected));
     }
 }
+
+/// Hiding and showing rows or columns keeps every formula result and runs no
+/// calculation: xlsx-calc reads hidden rows as visible, SUBTOTAL(109) included.
+#[test]
+fn visibility_keeps_formula_results() {
+    let rows = [
+        r#"<row r="1"><c r="A1"><v>1</v></c><c r="B1"><f>SUBTOTAL(109,A1:A3)</f></c><c r="C1"><f>SUM(A1:A3)</f></c></row>"#,
+        r#"<row r="2"><c r="A2"><v>2</v></c></row>"#,
+        r#"<row r="3"><c r="A3"><v>4</v></c></row>"#,
+    ]
+    .concat();
+    let bytes = sheets_package([rows, String::new(), String::new()], "");
+    let mut workbook = Workbook::open(&bytes).unwrap();
+    // uncached formulas wait for a first calculation
+    workbook.recalculate_all(options());
+    assert_eq!(value(&workbook, "B1"), number(7.0));
+    assert_eq!(value(&workbook, "C1"), number(7.0));
+    let before = values(&workbook);
+    let counters = calculation_counters(&workbook);
+    let hide = |hidden| {
+        vec![
+            Op::SetRowVisibility {
+                sheet: SheetId(0),
+                row: 1,
+                hidden,
+            },
+            Op::SetColVisibility {
+                sheet: SheetId(0),
+                col: 0,
+                hidden,
+            },
+        ]
+    };
+    for hidden in [true, false] {
+        track_formula_evaluations();
+        let result = workbook.apply_ops(hide(hidden), options()).unwrap();
+        assert_kept(&workbook, &result, &before, counters);
+        assert_eq!(workbook.model.sheets[0].row_hidden(1), hidden);
+    }
+    track_formula_evaluations();
+    let result = workbook.undo(options()).unwrap();
+    assert_kept(&workbook, &result, &before, counters);
+    assert!(workbook.model.sheets[0].row_hidden(1));
+}

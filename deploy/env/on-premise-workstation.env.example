# Context Pilot — ON-PREMISE, WORKSTATION profile (complete environment template)
#
# The product runs natively on the user's own machine: one person, no login,
# no reverse proxy, nothing to name or certify, no network to reconfigure. The
# cockpit is opened from this machine only (loopback).
#
# Where to put it: copy to ~/.context-pilot/.env (chmod 600). Both binaries
# merge that file into their environment at boot (it overrides the shell), then
# validate everything and refuse to start on any problem — `cpilot --check-env`
# and `cp-orchestrator --check-env` print the report. One KEY=value per line,
# no `export`, no quotes needed, an empty value counts as unset. Every variable
# either binary reads is listed below, set or commented (`#NAME=`); the
# reference with types, defaults and the combinations refused at boot is
# docs/ENV.md.

# ── Core ─────────────────────────────────────────────────────────────────────
# Inherited from the shell; must be an existing directory. `~/.context-pilot`
# (this file, registry, auth.db, releases, Meilisearch) lives under it.
#HOME=
# Parent of the central `context-pilot/config.json` store. Default: $HOME/.config
#XDG_CONFIG_HOME=
# Registry shared by the orchestrator and its agents. Default: $HOME/.context-pilot/agents
#CP_AGENTS_DIR=

# ── Orchestrator ─────────────────────────────────────────────────────────────
CP_ORCH_PORT=7878
# Loopback: the cockpit is used from this machine. Widen to 0.0.0.0 only behind
# a TLS-terminating proxy — the backend speaks cleartext.
CP_ORCH_BIND=127.0.0.1
#CP_SCAN_INTERVAL_MS=2000
# Where new agents' project directories are created. Default: $HOME/code
#CP_AGENTS_ROOT=
# The agent binary the supervisor spawns (deploy_local.sh installs it here).
CP_AGENT_BINARY=/usr/local/bin/cpilot
# Built cockpit to serve alongside the API (`web/dist` of a release bundle).
# Unset: only the API is served — use the Vite dev server or a separate web
# server for the UI.
#CP_WEB_ROOT=
# Default: <CP_AGENTS_DIR>/.provisioned
#CP_PROVISION_FLAG=
CP_RELEASES_BREAK_GLASS=0

# ── Authentication ───────────────────────────────────────────────────────────
# Single user on their own machine: no login. Every caller is a superadmin.
# Turn it on (and fill the seed below) to require a password on this machine.
CP_AUTH_ENABLED=0
#CP_SESSION_TTL_SECS=2592000
# Default: $HOME/.context-pilot/orchestrator/auth.db
#CP_AUTH_DB=

# ── Account seeding (only with CP_AUTH_ENABLED=1; refused otherwise) ─────────
#CP_SEED_SUPERADMIN_EMAIL=
#CP_SEED_SUPERADMIN_NAME=superadmin
#CP_SEED_SUPERADMIN_PASSWORD=
#CP_SEED_SUPERADMIN_PASSWORD_FILE=
#CP_SEED_ADMIN_EMAIL=
#CP_SEED_ADMIN_NAME=admin
#CP_SEED_ADMIN_PASSWORD=
#CP_SEED_ADMIN_PASSWORD_FILE=

# ── LLM gateway (optional) ───────────────────────────────────────────────────
# Unset: each provider is called directly with the keys below.
#CP_LLM_GATEWAY=
#CP_LLM_GATEWAY_KEY=

# ── Feature flags ────────────────────────────────────────────────────────────
# Claude Code subscription offered as a provider.
CP_FEATURE_CLAUDE_OAUTH=1
# No box to name, no certificate: no day-0 setup, no IT pane.
CP_FEATURE_DAY0_SETUP=0
CP_FEATURE_IT_PANE=0
# Updated by reinstalling (deploy_local.sh / a new release), not over the air.
CP_FEATURE_UPDATER=0
# Provider keys can be set from the cockpit (written to this file).
CP_FEATURE_KEYS_EDITABLE=1
CP_FEATURE_ONBOARDING=1

# ── Appliance gates — LEAVE UNSET on a workstation ──────────────────────────
# Set, they make the orchestrator rewrite this machine's Caddyfile and network
# configuration. Absent, the integrations are inert.
#CP_CADDYFILE=
#CP_CADDY_BIN=
#CP_CA_ROOT=
#CP_NMCLI_BIN=
#CP_MMCLI_BIN=
#CP_IW_BIN=
#CP_IP_BIN=
#CP_NETWORKCTL_BIN=
#CP_SYSTEMCTL_BIN=
#CP_NFT_BIN=
#CP_REGDOM_BIN=
#CP_NETWORKD_DIR=
#CP_UPLINK_ENV=
#CP_UPLINK_STATE=/run/cp-uplink/state
#CP_NETWORK_APPLIED=/run/cp-network-applied
#CP_WAN_IFACE=end0
#CP_AP_IFACE=wlp1s0
#CP_WWAN_DEV=cdc-wdm0
#CP_WWAN_PRESENT=

# ── Agent bridge — never set here ────────────────────────────────────────────
# The orchestrator sets both on every agent it spawns; a value in this file
# would override it (the file wins over the process environment).
#CP_BRIDGE=0
#CP_BRIDGE_URL=http://127.0.0.1:7878

# ── Developer ────────────────────────────────────────────────────────────────
#CP_FLAMEGRAPH=0
#CP_RUN_SH=0
#SHOW_CONTEXT_PILOT_IN_TREE=0

# ── Provider / integration API keys (resolved by the vault) ──────────────────
# At least one model provider is needed for an agent to answer. Keys set from
# the cockpit land in this same file.
#ANTHROPIC_API_KEY=
#XAI_API_KEY=
#GROQ_API_KEY=
#DEEPSEEK_API_KEY=
#MINIMAX_API_KEY=
#BRAVE_API_KEY=
#FIRECRAWL_API_KEY=
#DATALAB_API_KEY=
#VOYAGE_API_KEY=
#GITHUB_TOKEN=

# ── Chat bridges (resolved by the vault; none of these deployments run one) ──
#TELEGRAM_BOT_TOKEN=
#DISCORD_BOT_TOKEN=
#SLACK_BOT_TOKEN=
#GOOGLECHAT_BOT_TOKEN=
#TELEGRAM_API_ID=
#TELEGRAM_API_HASH=

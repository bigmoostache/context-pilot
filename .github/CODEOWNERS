# CODEOWNERS - Automatic reviewer assignment for Pull Requests
# https://docs.github.com/en/repositories/managing-your-repositorys-settings-and-features/customizing-your-repository/about-code-owners
#
# Every path below must exist: a stale entry silently stops matching and the
# area falls back to `*`. When the tree moves, update this file in the same PR.
# When you grow the team, replace @bigmoostache with specific reviewers per area.

# Default owner
* @bigmoostache

# Main binary (src/): event loop, infra, LLM providers, modules, state, TUI
/src/app/                     @bigmoostache
/src/infra/                   @bigmoostache
/src/llms/                    @bigmoostache
/src/modules/                 @bigmoostache
/src/state/                   @bigmoostache
/src/ui/                      @bigmoostache
/src/main.rs                  @bigmoostache

# Workspace crates. cp-wire is the agent/orchestrator wire contract and
# cp-vault holds the credential chokepoint: review both with extra care.
/crates/                      @bigmoostache
/crates/cp-wire/              @bigmoostache
/crates/cp-vault/             @bigmoostache
/crates/cp-orchestrator/      @bigmoostache


+//! Accepted base fingerprints, hashed on first use.
+//!
+//! Opening a workbook needs only the current fingerprint (it seeds the
+//! bootstrap client). The accepted readings — every legacy schema and style
+//! reading a peer may have persisted — cost one SHA-256 stream each over every
+//! cell (about a hundred of them), yet are read only when a peer snapshot is
+//! adopted, seeds are matched or a recovery state is written. They are hashed
+//! the first time any of those asks.
+
+use std::collections::BTreeMap;
+use std::fmt;
+use std::ops::{Deref, DerefMut};
+use std::sync::{Arc, Mutex, OnceLock};
+
+use xlsx_model::{Stylesheet, Workbook as WorkbookModel};
+
+use super::{FingerprintBuilder, append_fingerprint};
+
+type Map = BTreeMap<i64, Vec<String>>;
+
+/// What the accepted readings hash: the workbook as it was opened.
+struct Pending {
+    model: WorkbookModel,
+    legacy_dimensions: Vec<xlsx_parse::LegacySheetDimensions>,
+    legacy_styles: Option<Stylesheet>,
+    legacy_style_readings: Vec<Stylesheet>,
+}
+
+impl Pending {
+    fn compute(&self) -> Result<Map, String> {
+        let mut builder = FingerprintBuilder::new(&self.model, &self.legacy_dimensions);
+        builder.batched(|builder| {
+            let mut fingerprints =
+                builder.style_fingerprints(&self.model.styles, self.legacy_styles.as_ref())?;
+            for reading in &self.legacy_style_readings {
+                for (version, accepted) in builder.style_fingerprints(reading, None)? {
+                    for fingerprint in accepted {
+                        append_fingerprint(&mut fingerprints, version, fingerprint);
+                    }
+                }
+            }
+            Ok(fingerprints)
+        })
+    }
+}
+
+struct Inner {
+    ready: OnceLock<Map>,
+    pending: Mutex<Option<Pending>>,
+}
+
+/// Accepted fingerprints per schema version, computed on first access.
+#[derive(Clone)]
+pub(super) struct LazyFingerprints(Arc<Inner>);
+
+impl LazyFingerprints {
+    pub(super) fn pending(
+        model: &WorkbookModel,
+        legacy_dimensions: &[xlsx_parse::LegacySheetDimensions],
+        legacy_styles: Option<&Stylesheet>,
+        legacy_style_readings: &[Stylesheet],
+    ) -> Self {
+        Self(Arc::new(Inner {
+            ready: OnceLock::new(),
+            pending: Mutex::new(Some(Pending {
+                model: model.clone(),
+                legacy_dimensions: legacy_dimensions.to_vec(),
+                legacy_styles: legacy_styles.cloned(),
+                legacy_style_readings: legacy_style_readings.to_vec(),
+            })),
+        }))
+    }
+
+    /// Hashes the pending readings now. A workbook that fails to hash accepts
+    /// no reading, so every peer snapshot is refused rather than misread.
+    fn force(&self) -> &Map {
+        self.0.ready.get_or_init(|| {
+            let pending = self
+                .0
+                .pending
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner)
+                .take();
+            pending
+                .map(|pending| pending.compute().unwrap_or_default())
+                .unwrap_or_default()
+        })
+    }
+}
+
+impl From<Map> for LazyFingerprints {
+    fn from(map: Map) -> Self {
+        Self(Arc::new(Inner {
+            ready: OnceLock::from(map),
+            pending: Mutex::new(None),
+        }))
+    }
+}
+
+impl Default for LazyFingerprints {
+    fn default() -> Self {
+        Map::new().into()
+    }
+}
+
+impl Deref for LazyFingerprints {
+    type Target = Map;
+
+    fn deref(&self) -> &Map {
+        self.force()
+    }
+}
+
+impl DerefMut for LazyFingerprints {
+    fn deref_mut(&mut self) -> &mut Map {
+        if Arc::get_mut(&mut self.0).is_none() {
+            *self = self.force().clone().into();
+        }
+        let inner = Arc::get_mut(&mut self.0).expect("unshared after copy");
+        if inner.ready.get().is_none() {
+            let pending = inner
+                .pending
+                .get_mut()
+                .unwrap_or_else(std::sync::PoisonError::into_inner)
+                .take();
+            let map = pending
+                .map(|pending| pending.compute().unwrap_or_default())
+                .unwrap_or_default();
+            let _ = inner.ready.set(map);
+        }
+        inner.ready.get_mut().expect("initialised above")
+    }
+}
+
+impl IntoIterator for LazyFingerprints {
+    type Item = (i64, Vec<String>);
+    type IntoIter = std::collections::btree_map::IntoIter<i64, Vec<String>>;
+
+    fn into_iter(mut self) -> Self::IntoIter {
+        std::mem::take(&mut *self).into_iter()
+    }
+}
+
+impl PartialEq for LazyFingerprints {
+    fn eq(&self, other: &Self) -> bool {
+        **self == **other
+    }
+}
+
+impl fmt::Debug for LazyFingerprints {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        (**self).fmt(f)
+    }
+}

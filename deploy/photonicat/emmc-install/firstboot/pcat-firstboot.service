# pcat-firstboot.service — runs firstboot-emmc.sh once on the first eMMC boot.
#
# Ordered LATE (after network-online + tailscaled available) because step 6
# enrols into Tailscale, which needs the network stack and the tailscaled socket
# up. The script itself is idempotent + stamp-guarded, so an accidental re-run is
# harmless; this unit is also self-disabled by the script's last step.
#
# Installed + enabled by build-golden-image.sh into the golden image.

[Unit]
Description=Photonicat first-boot personalisation (identity, resize, tailscale)
# Only meaningful on the eMMC clone; harmless elsewhere (stamp guard).
After=network-online.target tailscaled.service
Wants=network-online.target
ConditionPathExists=!/var/lib/pcat-firstboot.done

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/firstboot-emmc.sh
RemainAfterExit=no
# Give resize2fs / tailscale room; don't wedge boot forever.
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target

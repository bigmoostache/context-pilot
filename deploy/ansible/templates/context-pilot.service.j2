# Context Pilot orchestrator — systemd unit (Armbian/Debian, glibc).
# Templated by Ansible; cp_root defaults to /opt/context-pilot (the Debian rootfs
# is the whole disk).
[Unit]
Description=Context Pilot orchestrator (cockpit on loopback :7878; Caddy fronts :80/:443)
Documentation=https://github.com/bigmoostache/context-pilot
After=network-online.target
Wants=network-online.target
# Crash-loop backoff: at most 5 restarts per hour before systemd gives up.
StartLimitIntervalSec=3600
StartLimitBurst=5

[Service]
Type=simple
# Persisted state (registry, auth.db, central config, Claude creds, agent
# project roots) all live under $HOME.
Environment=HOME={{ cp_root }}/home
Environment=CP_AUTH_ENABLED=1
Environment=CP_ORCH_PORT=7878
# Loopback only — the backend speaks cleartext HTTP and its auth model assumes
# an encrypted transport, so Caddy is the sole LAN-facing surface. This is the
# binary's default too; stated here so a `systemctl cat` shows the whole story.
Environment=CP_ORCH_BIND=127.0.0.1
# Caddy integration: the orchestrator regenerates this Caddyfile (name/IP,
# provisioned gate — cockpit on cleartext :80 at day-0, private-CA :443 once
# provisioned) and reloads Caddy through its admin API. No :9090 plane (§13.4).
Environment=CP_CADDYFILE={{ cp_root }}/caddy/Caddyfile
Environment=CP_CADDY_BIN={{ cp_root }}/bin/caddy
Environment=CP_CA_ROOT={{ cp_root }}/caddy/data/caddy/pki/authorities/local/root.crt
{% if cp_net_enabled | bool %}
# Network applier gates (docs/design-network-uplink.md §10). Each names one tool;
# with CP_NMCLI_BIN unset the applier is inert and the backend only persists, so
# a dev machine never touches its own network. Absolute paths, because the unit
# has no PATH worth relying on.
#
# THE WHOLE BLOCK IS CONDITIONAL ON cp_net_enabled, and that is load-bearing.
# This unit is templated by tasks/deploy.yml, which runs BEFORE tasks/net/network.yml
# installs NetworkManager and regardless of the feature switch. Setting the gates
# unconditionally made `-e net_enabled=false` the worst of both worlds: the
# applier believed it was live forever, so `reconcile_ap` hit a spawn error on a
# missing nmcli, returned Err, rolled back, and EVERY network POST answered 502.
# With the block absent the promise above ("with CP_NMCLI_BIN unset the applier
# is inert") is true of the box and not just of the code.
Environment=CP_NMCLI_BIN=/usr/bin/nmcli
Environment=CP_MMCLI_BIN=/usr/bin/mmcli
Environment=CP_IW_BIN=/usr/sbin/iw
Environment=CP_IP_BIN=/usr/sbin/ip
Environment=CP_NETWORKCTL_BIN=/usr/bin/networkctl
Environment=CP_SYSTEMCTL_BIN=/usr/bin/systemctl
Environment=CP_NFT_BIN=/usr/sbin/nft
Environment=CP_NETWORKD_DIR=/etc/systemd/network
Environment=CP_UPLINK_ENV=/etc/default/cp-uplink
# The failover supervisor's live state — `promoted`, `last_reason`,
# `last_transition` and the probe streaks, none of which /proc/net/route can
# express. cp-uplink-watch rewrites it every interval and GET /api/it/network
# projects it to the cockpit; the two sides read the SAME variable name with the
# SAME default, so a box where they disagree cannot happen silently.
Environment=CP_UPLINK_STATE=/run/cp-uplink/state
# The regulatory-domain script, shipped by tasks/net/network.yml. The applier
# CALLS it rather than duplicating `iw reg set` itself, so there is one
# implementation of "put the country in force" shared with the boot oneshot.
Environment=CP_REGDOM_BIN=/usr/local/sbin/cp-regdom
{% endif %}
# Served SPA — a `current` symlink the OTA updater atomically repoints at the
# active release's bundled front (`releases/<tag>/web`). Day-0 it points at
# `web/baseline` (the SPA Ansible shipped); a failed update never touches it.
Environment=CP_WEB_ROOT={{ cp_root }}/web/current
Environment=CP_AGENT_BINARY={{ cp_root }}/bin/tui
# Provisioning values (templated by Ansible, chmod 600). Loaded as KEY=value.
#   seed.env      — per-UNIT admin seed (CP_SEED_ADMIN_*); write-once, seeded
#                   only when the user table is empty (idempotent).
#   providers.env — per-CLIENT provider/integration API keys; rewritten each run.
# `-` prefix = optional (a factory-fresh box has neither yet).
EnvironmentFile=-{{ cp_root }}/seed.env
EnvironmentFile=-{{ cp_root }}/providers.env
ExecStartPre=/bin/mkdir -p {{ cp_root }}/home
ExecStart={{ cp_root }}/bin/cp-orchestrator
# `always`, not `on-failure`: the self-updater may end its old process with a
# clean-looking exit (its exec fallback), and `on-failure` would leave the box
# headless (M6 e2e, 2026-07-16). `systemctl stop` still stops for good —
# systemd never auto-restarts after an explicit stop.
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

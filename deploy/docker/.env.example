# Context Pilot — container configuration. Copy to .env, fill in, keep private:
#
#   cp .env.example .env && chmod 600 .env
#
# One KEY=value per line, no `export`, no quotes needed. This file IS the
# configuration: docker compose passes it into the container's environment
# verbatim, so anything the binaries read from the environment can go here.

# ── First boot: accounts (required) ──────────────────────────────────────────
# Seeded only while the user table is empty, exactly as on the appliance; ignored
# on every later start. Both accounts must change their password at first login.
#
# Generate a password with:  openssl rand -hex 16
#
# The superadmin is the vendor account — provider secrets, IT settings, and the
# only role that can create another superadmin. `docker compose up` refuses to
# start without it.
CP_SEED_SUPERADMIN_EMAIL=vendor@example.com
CP_SEED_SUPERADMIN_NAME=Vendor
CP_SEED_SUPERADMIN_PASSWORD=

# The customer's top account. Optional — a superadmin can create it later from
# the cockpit. Set the email and the password together or neither: an email with
# no password is skipped with a line in the log, not an error.
#CP_SEED_ADMIN_EMAIL=admin@example.com
#CP_SEED_ADMIN_NAME=Admin
#CP_SEED_ADMIN_PASSWORD=

# ── Provider / integration API keys ──────────────────────────────────────────
# At least one model provider is needed for an agent to answer. Rotating a key is
# editing this file and `docker compose up -d`. Keys set from the cockpit UI are
# stored in the volume and are not affected by what is here.
#ANTHROPIC_API_KEY=
#XAI_API_KEY=
#GROQ_API_KEY=
#DEEPSEEK_API_KEY=
#MINIMAX_API_KEY=

#BRAVE_API_KEY=
#FIRECRAWL_API_KEY=
#DATALAB_API_KEY=
#VOYAGE_API_KEY=
#GITHUB_TOKEN=

# ── Host ─────────────────────────────────────────────────────────────────────
# Published on 127.0.0.1 only; see the comment in docker-compose.yml before
# changing how this is exposed.
#CP_PORT=7878

# `local` builds from .artifacts/cpilot-linux-x86_64.tar.gz instead of a release.
#BUNDLE_SOURCE=release

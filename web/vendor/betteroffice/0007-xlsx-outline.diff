diff -ruN a/crates/betteroffice-xlsx/tests/outline.rs b/crates/betteroffice-xlsx/tests/outline.rs
--- a/crates/betteroffice-xlsx/tests/outline.rs	1970-01-01 01:00:00
+++ b/crates/betteroffice-xlsx/tests/outline.rs	2026-10-23 23:04:40
@@ -0,0 +1,205 @@
+//! Vendor patch 0007: row/column outlines. Levels are read-only source data;
+//! collapse/expand is a batch of row/col visibility ops, and `collapsed` on
+//! the summary row/col is derived from the hidden state when saving.
+
+use std::collections::BTreeMap;
+
+use betteroffice_xlsx::{CalculationOptions, Op, SheetId, Workbook};
+
+const MAIN: &str = "http://schemas.openxmlformats.org/spreadsheetml/2006/main";
+
+/// Rows 2..=6 at level 1 (summary row 7), rows 3..=4 at level 2 (summary
+/// row 5); columns B:C at level 1 with summary column D.
+const SHEET: &str = concat!(
+    r#"<cols><col min="2" max="3" width="9" customWidth="1" outlineLevel="1"/>"#,
+    r#"<col min="4" max="4" width="9" customWidth="1"/></cols>"#,
+    r#"<sheetData>"#,
+    r#"<row r="1"><c r="A1"><v>1</v></c></row>"#,
+    r#"<row r="2" outlineLevel="1"><c r="A2"><v>2</v></c></row>"#,
+    r#"<row r="3" outlineLevel="2"><c r="A3"><v>3</v></c></row>"#,
+    r#"<row r="4" outlineLevel="2"><c r="A4"><v>4</v></c></row>"#,
+    r#"<row r="5" outlineLevel="1"><c r="A5"><v>5</v></c></row>"#,
+    r#"<row r="6" outlineLevel="1"><c r="A6"><v>6</v></c></row>"#,
+    r#"<row r="7"><c r="A7"><v>7</v></c></row>"#,
+    r#"</sheetData>"#,
+);
+
+fn package(sheet_pr: &str, sheet_data: &str) -> Vec<u8> {
+    let parts = [
+        (
+            "[Content_Types].xml",
+            concat!(
+                r#"<?xml version="1.0" encoding="UTF-8" standalone="yes"?>"#,
+                r#"<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types">"#,
+                r#"<Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/>"#,
+                r#"<Default Extension="xml" ContentType="application/xml"/>"#,
+                r#"<Override PartName="/xl/workbook.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml"/>"#,
+                r#"<Override PartName="/xl/worksheets/sheet1.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"/>"#,
+                r#"</Types>"#,
+            )
+            .to_owned(),
+        ),
+        (
+            "_rels/.rels",
+            concat!(
+                r#"<?xml version="1.0" encoding="UTF-8" standalone="yes"?>"#,
+                r#"<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">"#,
+                r#"<Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="xl/workbook.xml"/>"#,
+                r#"</Relationships>"#,
+            )
+            .to_owned(),
+        ),
+        (
+            "xl/workbook.xml",
+            format!(
+                concat!(
+                    r#"<?xml version="1.0" encoding="UTF-8" standalone="yes"?>"#,
+                    r#"<workbook xmlns="{main}" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships">"#,
+                    r#"<sheets><sheet name="Sheet1" sheetId="1" r:id="rId1"/></sheets></workbook>"#,
+                ),
+                main = MAIN,
+            ),
+        ),
+        (
+            "xl/_rels/workbook.xml.rels",
+            concat!(
+                r#"<?xml version="1.0" encoding="UTF-8" standalone="yes"?>"#,
+                r#"<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">"#,
+                r#"<Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet" Target="worksheets/sheet1.xml"/>"#,
+                r#"</Relationships>"#,
+            )
+            .to_owned(),
+        ),
+        (
+            "xl/worksheets/sheet1.xml",
+            format!(
+                r#"<?xml version="1.0" encoding="UTF-8" standalone="yes"?><worksheet xmlns="{MAIN}">{sheet_pr}{sheet_data}</worksheet>"#
+            ),
+        ),
+    ]
+    .map(|(path, xml)| (path.to_owned(), xml.into_bytes()));
+    ooxml_opc::rezip_parts(&parts).unwrap()
+}
+
+fn sheet_xml(bytes: &[u8]) -> String {
+    let parts: BTreeMap<String, Vec<u8>> = ooxml_opc::unzip_parts(bytes).unwrap().into_iter().collect();
+    String::from_utf8(parts["xl/worksheets/sheet1.xml"].clone()).unwrap()
+}
+
+/// The `<row>` start tag for 1-based row `r`.
+fn row_tag(xml: &str, r: u32) -> &str {
+    let start = xml.find(&format!(r#"<row r="{r}""#)).unwrap();
+    &xml[start..start + xml[start..].find('>').unwrap()]
+}
+
+fn set_rows(workbook: &mut Workbook, rows: &[u32], hidden: bool) {
+    let ops = rows
+        .iter()
+        .map(|&row| Op::SetRowVisibility { sheet: SheetId(0), row, hidden })
+        .collect();
+    workbook.apply_ops(ops, CalculationOptions::default()).unwrap();
+}
+
+#[test]
+fn parse_reads_levels_and_summary_placement() {
+    let workbook = Workbook::open(&package("", SHEET)).unwrap();
+    let outline = &workbook.model().sheets[0].outline;
+    assert_eq!(
+        outline.rows.iter().map(|(&r, &l)| (r, l)).collect::<Vec<_>>(),
+        vec![(1, 1), (2, 2), (3, 2), (4, 1), (5, 1)]
+    );
+    assert_eq!(outline.cols.iter().map(|(&c, &l)| (c, l)).collect::<Vec<_>>(), vec![(1, 1), (2, 1)]);
+    assert!(!outline.summary_above && !outline.summary_left);
+
+    let above = package(
+        r#"<sheetPr><outlinePr summaryBelow="0" summaryRight="0"/></sheetPr>"#,
+        SHEET,
+    );
+    let workbook = Workbook::open(&above).unwrap();
+    let outline = &workbook.model().sheets[0].outline;
+    assert!(outline.summary_above && outline.summary_left);
+}
+
+#[test]
+fn collapsing_a_group_marks_its_summary_row_collapsed_on_save() {
+    let mut workbook = Workbook::open(&package("", SHEET)).unwrap();
+    set_rows(&mut workbook, &[2, 3], true);
+    let saved = workbook.save().unwrap();
+    let xml = sheet_xml(&saved);
+    assert!(row_tag(&xml, 5).contains(r#"collapsed="1""#), "{xml}");
+    assert!(!row_tag(&xml, 7).contains("collapsed"), "{xml}");
+
+    let mut reopened = Workbook::open(&saved).unwrap();
+    assert!(reopened.model().sheets[0].row_hidden(2));
+    assert!(reopened.model().sheets[0].row_hidden(3));
+
+    set_rows(&mut reopened, &[2, 3], false);
+    let xml = sheet_xml(&reopened.save().unwrap());
+    assert!(!row_tag(&xml, 5).contains("collapsed"), "{xml}");
+}
+
+/// Documented limit of 0007: the inner group's own collapsed state is not
+/// stored, so expanding the outer group (unhiding its direct rows) brings a
+/// previously open inner group back collapsed. Excel would restore it open.
+#[test]
+fn expanding_outer_group_brings_inner_back_collapsed() {
+    let mut workbook = Workbook::open(&package("", SHEET)).unwrap();
+    // collapse outer: every row at level >= 1 hidden
+    set_rows(&mut workbook, &[1, 2, 3, 4, 5], true);
+    // expand outer: unhide its direct rows only
+    set_rows(&mut workbook, &[1, 4, 5], false);
+    let sheet = &workbook.model().sheets[0];
+    assert!(sheet.row_hidden(2) && sheet.row_hidden(3));
+    let xml = sheet_xml(&workbook.save().unwrap());
+    assert!(row_tag(&xml, 5).contains(r#"collapsed="1""#), "{xml}");
+    assert!(!row_tag(&xml, 7).contains("collapsed"), "{xml}");
+}
+
+#[test]
+fn collapsing_a_column_group_marks_its_summary_column() {
+    let mut workbook = Workbook::open(&package("", SHEET)).unwrap();
+    let ops = [1, 2]
+        .into_iter()
+        .map(|col| Op::SetColVisibility { sheet: SheetId(0), col, hidden: true })
+        .collect();
+    workbook.apply_ops(ops, CalculationOptions::default()).unwrap();
+    let xml = sheet_xml(&workbook.save().unwrap());
+    let d = xml.find(r#"<col min="4""#).unwrap();
+    let tag = &xml[d..d + xml[d..].find('>').unwrap()];
+    assert!(tag.contains(r#"collapsed="1""#), "{xml}");
+}
+
+/// Collapse is a batch of synced visibility ops: a second replica receiving the
+/// update sees the rows hidden and saves the summary row collapsed too.
+#[test]
+fn collapse_merges_into_a_second_replica() {
+    let source = package("", SHEET);
+    let mut a = Workbook::open_collaborative(&source, 1).unwrap();
+    let mut b = Workbook::open_collaborative(&source, 2).unwrap();
+    let updates = std::sync::Arc::new(std::sync::Mutex::new(Vec::new()));
+    let observed = std::sync::Arc::clone(&updates);
+    let subscription = a
+        .observe_update_v1(move |event| observed.lock().unwrap().push(event.update))
+        .unwrap();
+    set_rows(&mut a, &[2, 3], true);
+    drop(subscription);
+    let updates = updates.lock().unwrap().clone();
+    assert!(!updates.is_empty());
+    for update in &updates {
+        b.apply_update_v1(update, CalculationOptions::default()).unwrap();
+    }
+    let sheet = &b.model().sheets[0];
+    assert!(sheet.row_hidden(2) && sheet.row_hidden(3) && !sheet.row_hidden(4));
+    assert_eq!(sheet.outline.rows.len(), 5);
+    let xml = sheet_xml(&b.save().unwrap());
+    assert!(row_tag(&xml, 5).contains(r#"collapsed="1""#), "{xml}");
+}
+
+#[test]
+fn untouched_outlined_sheet_saves_byte_identical() {
+    let source = package("", SHEET);
+    let mut workbook = Workbook::open(&source).unwrap();
+    set_rows(&mut workbook, &[2], true);
+    set_rows(&mut workbook, &[2], false);
+    assert_eq!(sheet_xml(&workbook.save().unwrap()), sheet_xml(&source));
+}

0009-xlsx-windows-column-widths: rowMetrics="windows" (0005) now covers
columns too: screen <col width> -> pixels by ECMA-376 18.3.1.13
(trunc((256w + trunc(128/mdw))/256 * mdw), shared with PrintMetrics::column_pixels),
like Excel for Windows / the web. The mac default keeps col_chars_to_px.
Applies on top of 0001-0008.

--- a/crates/xlsx-render/src/geometry.rs
+++ b/crates/xlsx-render/src/geometry.rs
@@ -379,9 +379,30 @@
     }
 
     pub fn column_pixels(&self, width: f64) -> f32 {
-        let digit = self.max_digit_width as f64;
-        (((256.0 * width + (128.0 / digit).floor()) / 256.0 * digit).floor() * 96.0
-            / self.dpi as f64) as f32
+        ecma_column_pixels(width, self.max_digit_width as f64, self.dpi as f64)
+    }
+}
+
+/// ecma-376 §18.3.1.13's width-to-pixels: the stored `width` already counts
+/// the padding, so it is truncated onto whole `digit` pixels at `dpi`.
+fn ecma_column_pixels(width: f64, digit: f64, dpi: f64) -> f32 {
+    (((256.0 * width + (128.0 / digit).floor()) / 256.0 * digit).floor() * 96.0 / dpi) as f32
+}
+
+/// screen column width in characters -> pixels the way excel for windows and
+/// the web draw it: [`ecma_column_pixels`] with the default font's digit at
+/// 96dpi (16.29 -> 114px, where [`col_chars_to_px`] adds the padding again).
+pub fn windows_col_px(chars: f64) -> f32 {
+    ecma_column_pixels(chars, MAX_DIGIT_WIDTH_PX, 96.0)
+}
+
+impl RowFit {
+    /// screen column pixels for this flavour.
+    fn column_px(self, chars: f64) -> f32 {
+        match self {
+            Self::ScreenWindows => windows_col_px(chars),
+            _ => col_chars_to_px(chars),
+        }
     }
 }
 

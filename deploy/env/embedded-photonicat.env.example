# Context Pilot — EMBEDDED, PHOTONICAT 2 profile (complete environment template)
#
# The appliance: everything on. Login enforced with per-unit seeded accounts,
# Caddy with the box's private CA and the day-0 setup (the client's IT names
# the box and distributes the root certificate), the IT pane driving the
# Ethernet/5G uplink and the Wi-Fi access point through NetworkManager, the
# uplink failover supervisor, and over-the-air updates.
#
# On a box provisioned by Ansible these values are rendered into the systemd
# unit (deploy/ansible/templates/context-pilot.service.j2) plus seed.env and
# providers.env — this file documents that profile in one place and can be
# dropped at /opt/context-pilot/home/.context-pilot/.env (chmod 600) to
# override the unit: the orchestrator merges it at boot, validates everything
# (every `*_BIN` must exist and be executable) and refuses to start on any
# problem — `cp-orchestrator --check-env` prints the report. Every variable is
# listed, set or commented (`#NAME=`); the reference is docs/ENV.md.

# ── Core ─────────────────────────────────────────────────────────────────────
HOME=/opt/context-pilot/home
#XDG_CONFIG_HOME=
# Default: $HOME/.context-pilot/agents
#CP_AGENTS_DIR=

# ── Orchestrator ─────────────────────────────────────────────────────────────
CP_ORCH_PORT=7878
# Loopback ONLY: Caddy is the sole LAN-facing surface (verified at every
# deployment by tasks/start.yml).
CP_ORCH_BIND=127.0.0.1
#CP_SCAN_INTERVAL_MS=2000
# Default: $HOME/code
#CP_AGENTS_ROOT=
CP_AGENT_BINARY=/opt/context-pilot/bin/tui
# A `current` symlink the OTA updater atomically repoints at each release.
CP_WEB_ROOT=/opt/context-pilot/web/current
# Default: <CP_AGENTS_DIR>/.provisioned
#CP_PROVISION_FLAG=
# Recovery hatch only (over Tailscale SSH): re-enables manual version choice.
CP_RELEASES_BREAK_GLASS=0

# ── Authentication ───────────────────────────────────────────────────────────
CP_AUTH_ENABLED=1
CP_SESSION_TTL_SECS=2592000
# Default: $HOME/.context-pilot/orchestrator/auth.db
#CP_AUTH_DB=

# ── Account seeding (per unit; Ansible renders seed.env, chmod 600) ──────────
# The vendor account and the client's admin, each with a per-unit generated
# password shipped on paper in the box; both must change it at first login.
CP_SEED_SUPERADMIN_EMAIL=vendor@context-pilot.internal
CP_SEED_SUPERADMIN_NAME=Vendor
CP_SEED_SUPERADMIN_PASSWORD=
#CP_SEED_SUPERADMIN_PASSWORD_FILE=
CP_SEED_ADMIN_EMAIL=admin@admin.fr
CP_SEED_ADMIN_NAME=Admin
CP_SEED_ADMIN_PASSWORD=
#CP_SEED_ADMIN_PASSWORD_FILE=

# ── LLM gateway ──────────────────────────────────────────────────────────────
# The box talks to each provider directly with the client's keys.
#CP_LLM_GATEWAY=
#CP_LLM_GATEWAY_KEY=

# ── Feature flags — all on ───────────────────────────────────────────────────
CP_FEATURE_CLAUDE_OAUTH=1
CP_FEATURE_DAY0_SETUP=1
CP_FEATURE_IT_PANE=1
CP_FEATURE_UPDATER=1
CP_FEATURE_KEYS_EDITABLE=1
CP_FEATURE_ONBOARDING=1

# ── Appliance gates: Caddy / TLS ─────────────────────────────────────────────
CP_CADDYFILE=/opt/context-pilot/caddy/Caddyfile
CP_CADDY_BIN=/opt/context-pilot/bin/caddy
CP_CA_ROOT=/opt/context-pilot/caddy/data/caddy/pki/authorities/local/root.crt

# ── Appliance gates: network applier (NetworkManager on Armbian) ─────────────
# `nmcli` is the master gate: with it set the cockpit reconfigures THIS box's
# network. Absolute paths — the unit has no PATH worth relying on.
CP_NMCLI_BIN=/usr/bin/nmcli
CP_MMCLI_BIN=/usr/bin/mmcli
CP_IW_BIN=/usr/sbin/iw
CP_IP_BIN=/usr/sbin/ip
CP_NETWORKCTL_BIN=/usr/bin/networkctl
CP_SYSTEMCTL_BIN=/usr/bin/systemctl
CP_NFT_BIN=/usr/sbin/nft
CP_REGDOM_BIN=/usr/local/sbin/cp-regdom
CP_NETWORKD_DIR=/etc/systemd/network
# Failover supervisor (cp-uplink-watch): its configuration, regenerated by the
# applier, and the live state it publishes for the cockpit.
CP_UPLINK_ENV=/etc/default/cp-uplink
CP_UPLINK_STATE=/run/cp-uplink/state
CP_NETWORK_APPLIED=/run/cp-network-applied
# Photonicat 2 hardware: the Ethernet uplink port, the ath11k radio for the
# access point (wlan0 stays free for a future Wi-Fi client uplink), the
# RM520N-GL modem's control port.
CP_WAN_IFACE=end0
CP_AP_IFACE=wlp1s0
CP_WWAN_DEV=cdc-wdm0
# Probed from sysfs; force 0|1 only for a variant the probe reads wrong.
#CP_WWAN_PRESENT=

# ── Agent bridge — never set here ────────────────────────────────────────────
# The orchestrator sets both on every agent it spawns; a value in this file
# would override it (the file wins over the process environment).
#CP_BRIDGE=0
#CP_BRIDGE_URL=http://127.0.0.1:7878

# ── Developer — off on a box ─────────────────────────────────────────────────
#CP_FLAMEGRAPH=0
#CP_RUN_SH=0
#SHOW_CONTEXT_PILOT_IN_TREE=0

# ── Provider / integration API keys (per client; Ansible renders providers.env)
#ANTHROPIC_API_KEY=
#XAI_API_KEY=
#GROQ_API_KEY=
#DEEPSEEK_API_KEY=
#MINIMAX_API_KEY=
#BRAVE_API_KEY=
#FIRECRAWL_API_KEY=
#DATALAB_API_KEY=
#VOYAGE_API_KEY=
#GITHUB_TOKEN=

# ── Chat bridges (resolved by the vault; none of these deployments run one) ──
#TELEGRAM_BOT_TOKEN=
#DISCORD_BOT_TOKEN=
#SLACK_BOT_TOKEN=
#GOOGLECHAT_BOT_TOKEN=
#TELEGRAM_API_ID=
#TELEGRAM_API_HASH=

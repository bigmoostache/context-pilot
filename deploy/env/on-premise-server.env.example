# Context Pilot — ON-PREMISE, SERVER profile (complete environment template)
#
# A home-lab or company server the team reaches over the LAN: login enforced,
# Caddy in front with the box's own private CA (the IT admin names the machine
# and distributes the root certificate on first login — the day-0 setup),
# over-the-air updates, and the IT pane to manage identity, TLS and — if the
# server runs NetworkManager and you want the cockpit to drive it — the uplink
# and access point.
#
# Where to put it: /opt/context-pilot/home/.context-pilot/.env (chmod 600,
# owned by the service user); the layout below mirrors the systemd unit
# deploy/ansible/templates/context-pilot.service.j2. The orchestrator merges the
# file at boot, validates everything and refuses to start on any problem —
# `cp-orchestrator --check-env` prints the report. One KEY=value per line, no
# `export`, an empty value counts as unset. Every variable is listed, set or
# commented (`#NAME=`); the reference is docs/ENV.md.

# ── Core ─────────────────────────────────────────────────────────────────────
HOME=/opt/context-pilot/home
#XDG_CONFIG_HOME=
# Default: $HOME/.context-pilot/agents
#CP_AGENTS_DIR=

# ── Orchestrator ─────────────────────────────────────────────────────────────
CP_ORCH_PORT=7878
# Loopback ONLY: Caddy is the sole LAN-facing surface. The backend speaks
# cleartext and its auth model assumes an encrypted transport.
CP_ORCH_BIND=127.0.0.1
#CP_SCAN_INTERVAL_MS=2000
# Default: $HOME/code
#CP_AGENTS_ROOT=
CP_AGENT_BINARY=/opt/context-pilot/bin/tui
# The served cockpit: a `current` symlink the updater repoints on each release.
CP_WEB_ROOT=/opt/context-pilot/web/current
# Default: <CP_AGENTS_DIR>/.provisioned
#CP_PROVISION_FLAG=
CP_RELEASES_BREAK_GLASS=0

# ── Authentication ───────────────────────────────────────────────────────────
CP_AUTH_ENABLED=1
CP_SESSION_TTL_SECS=2592000
# Default: $HOME/.context-pilot/orchestrator/auth.db
#CP_AUTH_DB=

# ── Account seeding (first boot only, idempotent) ────────────────────────────
# Seeded while the user table is empty; both accounts must change their
# password at first login. Prefer the `_PASSWORD_FILE` form (chmod 600): the
# secret stays out of the process environment. An email without a password is
# refused at boot.
CP_SEED_SUPERADMIN_EMAIL=vendor@example.com
CP_SEED_SUPERADMIN_NAME=Vendor
#CP_SEED_SUPERADMIN_PASSWORD=
CP_SEED_SUPERADMIN_PASSWORD_FILE=/opt/context-pilot/secrets/superadmin.pw
CP_SEED_ADMIN_EMAIL=admin@example.com
CP_SEED_ADMIN_NAME=Admin
#CP_SEED_ADMIN_PASSWORD=
CP_SEED_ADMIN_PASSWORD_FILE=/opt/context-pilot/secrets/admin.pw

# ── LLM gateway (optional) ───────────────────────────────────────────────────
#CP_LLM_GATEWAY=
#CP_LLM_GATEWAY_KEY=

# ── Feature flags ────────────────────────────────────────────────────────────
CP_FEATURE_CLAUDE_OAUTH=1
# The IT admin names the server and distributes the CA root on first login.
CP_FEATURE_DAY0_SETUP=1
# Identity, TLS trust, and (with the gates below) uplink / access point.
CP_FEATURE_IT_PANE=1
CP_FEATURE_UPDATER=1
CP_FEATURE_KEYS_EDITABLE=1
CP_FEATURE_ONBOARDING=1

# ── Appliance gates: Caddy (required by the IT pane and the day-0 setup) ─────
# The orchestrator regenerates this Caddyfile (name/IP, cleartext :80 at day-0,
# private-CA :443 once provisioned) and reloads Caddy through its binary.
CP_CADDYFILE=/opt/context-pilot/caddy/Caddyfile
CP_CADDY_BIN=/opt/context-pilot/bin/caddy
CP_CA_ROOT=/opt/context-pilot/caddy/data/caddy/pki/authorities/local/root.crt

# ── Appliance gates: network applier (optional on a server) ──────────────────
# Unset, the IT pane still persists the network document but never touches the
# host: keep it that way unless the server runs NetworkManager and you want the
# cockpit to drive the uplink and the Wi-Fi access point. Then set the tools,
# ADAPT THE INTERFACE NAMES to this machine, and install the uplink supervisor
# (deploy/photonicat/network/) if you want failover.
#CP_NMCLI_BIN=/usr/bin/nmcli
#CP_MMCLI_BIN=/usr/bin/mmcli
#CP_IW_BIN=/usr/sbin/iw
#CP_IP_BIN=/usr/sbin/ip
#CP_NETWORKCTL_BIN=/usr/bin/networkctl
#CP_SYSTEMCTL_BIN=/usr/bin/systemctl
#CP_NFT_BIN=/usr/sbin/nft
#CP_REGDOM_BIN=/usr/local/sbin/cp-regdom
#CP_NETWORKD_DIR=/etc/systemd/network
#CP_UPLINK_ENV=/etc/default/cp-uplink
#CP_UPLINK_STATE=/run/cp-uplink/state
#CP_NETWORK_APPLIED=/run/cp-network-applied
#CP_WAN_IFACE=end0
#CP_AP_IFACE=wlp1s0
#CP_WWAN_DEV=cdc-wdm0
# A server has no 5G modem: say so, or the cockpit offers the 5G uplink modes.
CP_WWAN_PRESENT=0

# ── Agent bridge — never set here ────────────────────────────────────────────
# The orchestrator sets both on every agent it spawns; a value in this file
# would override it (the file wins over the process environment).
#CP_BRIDGE=0
#CP_BRIDGE_URL=http://127.0.0.1:7878

# ── Developer ────────────────────────────────────────────────────────────────
#CP_FLAMEGRAPH=0
#CP_RUN_SH=0
#SHOW_CONTEXT_PILOT_IN_TREE=0

# ── Provider / integration API keys (resolved by the vault) ──────────────────
# Keys set from the cockpit by a superadmin land in this same file.
#ANTHROPIC_API_KEY=
#XAI_API_KEY=
#GROQ_API_KEY=
#DEEPSEEK_API_KEY=
#MINIMAX_API_KEY=
#BRAVE_API_KEY=
#FIRECRAWL_API_KEY=
#DATALAB_API_KEY=
#VOYAGE_API_KEY=
#GITHUB_TOKEN=

# ── Chat bridges (resolved by the vault; none of these deployments run one) ──
#TELEGRAM_BOT_TOKEN=
#DISCORD_BOT_TOKEN=
#SLACK_BOT_TOKEN=
#GOOGLECHAT_BOT_TOKEN=
#TELEGRAM_API_ID=
#TELEGRAM_API_HASH=

diff -ruN a/crates/xlsx-model/src/outline.rs b/crates/xlsx-model/src/outline.rs
--- a/crates/xlsx-model/src/outline.rs	1970-01-01 01:00:00
+++ b/crates/xlsx-model/src/outline.rs	2026-10-23 23:04:40
@@ -0,0 +1,214 @@
+//! Row and column outlines (grouping): levels authored in the file plus the
+//! summary placement. Levels are read-only reference data; which groups are
+//! collapsed is not stored but derived from the hidden state, the way Excel
+//! recomputes it.
+
+use std::collections::BTreeMap;
+
+/// One axis of a sheet's outline: the `outlineLevel` of each grouped index.
+pub type OutlineLevels = BTreeMap<u32, u8>;
+
+/// Excel's deepest outline level.
+pub const MAX_OUTLINE_LEVEL: u8 = 7;
+
+/// A sheet's outline. Default = no groups, summaries below and right (Excel's
+/// default `summaryBelow="1" summaryRight="1"`).
+///
+/// Excluded from `Sheet` equality (every two outlines compare equal): it is
+/// read-only source data that does not follow row/column inserts or deletes,
+/// so it is not part of the edited model's identity. Compare fields directly.
+#[derive(Debug, Clone, Default)]
+pub struct SheetOutline {
+    pub rows: OutlineLevels,
+    pub cols: OutlineLevels,
+    /// `summaryBelow="0"`: a row group's summary row sits above it.
+    pub summary_above: bool,
+    /// `summaryRight="0"`: a column group's summary column sits left of it.
+    pub summary_left: bool,
+}
+
+/// A maximal run of indices at `level` or deeper, with its summary index.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct OutlineGroup {
+    pub level: u8,
+    pub first: u32,
+    pub last: u32,
+    /// The index carrying the group's +/- control (and `collapsed` in the file).
+    pub summary: u32,
+}
+
+impl PartialEq for SheetOutline {
+    fn eq(&self, _: &Self) -> bool {
+        true
+    }
+}
+
+impl Eq for SheetOutline {}
+
+impl SheetOutline {
+    /// No groups, Excel's default summary placement.
+    pub const EMPTY: Self = Self {
+        rows: BTreeMap::new(),
+        cols: BTreeMap::new(),
+        summary_above: false,
+        summary_left: false,
+    };
+
+    pub fn is_empty(&self) -> bool {
+        self.rows.is_empty() && self.cols.is_empty()
+    }
+}
+
+/// Every group of one axis, outer levels first, then by position.
+pub fn outline_groups(levels: &OutlineLevels, summary_before: bool) -> Vec<OutlineGroup> {
+    let deepest = levels.values().copied().max().unwrap_or(0);
+    let mut groups = Vec::new();
+    for level in 1..=deepest {
+        let mut run: Option<(u32, u32)> = None;
+        let close = |run: (u32, u32), groups: &mut Vec<OutlineGroup>| {
+            let summary = if summary_before {
+                run.0.saturating_sub(1)
+            } else {
+                run.1.saturating_add(1)
+            };
+            groups.push(OutlineGroup {
+                level,
+                first: run.0,
+                last: run.1,
+                summary,
+            });
+        };
+        for (&index, &at) in levels {
+            if at < level {
+                continue;
+            }
+            run = match run {
+                Some((first, last)) if last.checked_add(1) == Some(index) => Some((first, index)),
+                Some(done) => {
+                    close(done, &mut groups);
+                    Some((index, index))
+                }
+                None => Some((index, index)),
+            };
+        }
+        if let Some(done) = run {
+            close(done, &mut groups);
+        }
+    }
+    groups
+}
+
+/// Summary indices whose group is collapsed: every index directly inside the
+/// group (at the group's level, not in a deeper group) is hidden. This is the
+/// `collapsed` attribute Excel writes on the summary row/column.
+pub fn collapsed_summaries(
+    levels: &OutlineLevels,
+    summary_before: bool,
+    hidden: impl Fn(u32) -> bool,
+) -> Vec<u32> {
+    let mut out: Vec<u32> = outline_groups(levels, summary_before)
+        .into_iter()
+        .filter(|group| {
+            let mut direct = (group.first..=group.last)
+                .filter(|index| levels.get(index) == Some(&group.level))
+                .peekable();
+            direct.peek().is_some() && direct.all(|index| hidden(index))
+        })
+        .map(|group| group.summary)
+        .collect();
+    out.sort_unstable();
+    out.dedup();
+    out
+}
+
+/// Whether `summary` is the summary index of a collapsed group: some group
+/// sits right next to it (above/left when `summary_before` is false, else
+/// below/right) and every index directly in that group is hidden. Only walks
+/// the adjacent runs, so it is cheap for indices away from a group edge.
+pub fn summary_collapsed(
+    levels: &OutlineLevels,
+    summary_before: bool,
+    summary: u32,
+    hidden: impl Fn(u32) -> bool,
+) -> bool {
+    let step = |index: u32| {
+        if summary_before {
+            index.checked_add(1)
+        } else {
+            index.checked_sub(1)
+        }
+    };
+    let Some(edge) = step(summary) else {
+        return false;
+    };
+    let Some(&deepest) = levels.get(&edge) else {
+        return false;
+    };
+    let own = levels.get(&summary).copied().unwrap_or(0);
+    (own + 1..=deepest).any(|level| {
+        let mut at = Some(edge);
+        let mut any = false;
+        while let Some(index) = at {
+            match levels.get(&index) {
+                Some(&l) if l >= level => {
+                    if l == level {
+                        if !hidden(index) {
+                            return false;
+                        }
+                        any = true;
+                    }
+                }
+                _ => break,
+            }
+            at = step(index);
+        }
+        any
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn levels(pairs: &[(u32, u8)]) -> OutlineLevels {
+        pairs.iter().copied().collect()
+    }
+
+    #[test]
+    fn groups_nest_by_level_with_summary_below() {
+        // rows 1..=6 at level 1, rows 2..=3 at level 2
+        let l = levels(&[(1, 1), (2, 2), (3, 2), (4, 1), (5, 1), (6, 1)]);
+        let g = outline_groups(&l, false);
+        assert_eq!(
+            g,
+            vec![
+                OutlineGroup { level: 1, first: 1, last: 6, summary: 7 },
+                OutlineGroup { level: 2, first: 2, last: 3, summary: 4 },
+            ]
+        );
+        assert_eq!(outline_groups(&l, true)[0].summary, 0);
+    }
+
+    #[test]
+    fn collapsed_is_derived_from_direct_children() {
+        let l = levels(&[(1, 1), (2, 2), (3, 2), (4, 1)]);
+        let hidden = [2u32, 3];
+        assert_eq!(collapsed_summaries(&l, false, |i| hidden.contains(&i)), vec![4]);
+        let all = [1u32, 2, 3, 4];
+        // outer collapsed hides everything: both summaries read as collapsed,
+        // so expanding the outer later brings the inner back collapsed.
+        assert_eq!(collapsed_summaries(&l, false, |i| all.contains(&i)), vec![4, 5]);
+    }
+
+    #[test]
+    fn summary_collapsed_matches_full_derivation() {
+        let l = levels(&[(1, 1), (2, 2), (3, 2), (4, 1), (6, 1)]);
+        for hidden in [vec![], vec![2u32, 3], vec![1, 2, 3, 4], vec![6], vec![1, 4]] {
+            let h = |i: u32| hidden.contains(&i);
+            let full = collapsed_summaries(&l, false, h);
+            for index in 0..10 {
+                assert_eq!(summary_collapsed(&l, false, index, h), full.contains(&index), "{index} {hidden:?}");
+            }
+        }
+    }
+}

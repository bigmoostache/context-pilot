# pcat-provision.service — installs Context Pilot on the eMMC box by running the
# Ansible play locally, once, on first boot.
#
# Ordered AFTER pcat-firstboot (identity/resize/tailscale must be done first) and
# after the network is up (the play downloads the release bundle + Caddy). Kept
# as its own phase — NOT inside firstboot — because it is slow (artifact download
# + compiling the GC9307 display driver from source) and must get a generous
# timeout without holding up boot or the access planes firstboot brought up.
#
# Installed + enabled into the golden image by build-golden-image.sh. The script
# stamps /var/lib/pcat-provision.done and self-disables, so it runs exactly once.

[Unit]
Description=Photonicat self-provision Context Pilot (local Ansible)
# firstboot personalises identity + enrols tailscale; provisioning needs that
# done and the network reachable to fetch the public release artifacts.
After=pcat-firstboot.service network-online.target tailscaled.service
Wants=network-online.target
Requires=pcat-firstboot.service
ConditionPathExists=!/var/lib/pcat-provision.done

[Service]
Type=oneshot
ExecStart=/opt/pcat-provision/pcat-provision.sh
RemainAfterExit=yes
# Release download + Caddy + compiling the display driver from source can take
# many minutes on this board; give it room but stay bounded so a hung step never
# wedges boot forever (the unit is non-critical: a failure leaves the box up and
# reachable for a manual re-run).
TimeoutStartSec=2400

[Install]
WantedBy=multi-user.target
